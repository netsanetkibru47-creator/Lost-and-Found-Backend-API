          "name": "1. Create item (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "const item = pm.response.json();",
                  "pm.test(\"Returns created item with id\", function () { pm.expect(item.id).to.be.a(\"number\"); pm.expect(item.is_claimed).to.eql(false); });",
                  "pm.collectionVariables.set(\"itemId\", item.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
